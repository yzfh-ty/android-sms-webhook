# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# WorkManager persists worker class names across process restarts and app upgrades.
-keep class com.tyverse.smswebhook.delivery.WebhookWorker { public <init>(android.content.Context, androidx.work.WorkerParameters); }
-keep class com.tyverse.smswebhook.delivery.RecoveryWorker { public <init>(android.content.Context, androidx.work.WorkerParameters); }
-keep class com.tyverse.smswebhook.esim.EsimReminderWorker { public <init>(android.content.Context, androidx.work.WorkerParameters); }
-keep class com.tyverse.smswebhook.ui.RelayViewModel { public <init>(android.app.Application); }
